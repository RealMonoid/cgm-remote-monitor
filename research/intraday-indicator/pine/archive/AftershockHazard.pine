//@version=6
// ARCHIVED / REJECTED PROTOTYPE (v0): online logistic shock-probability model. In the as-deployed
// online evaluation (results/online_eval.csv) FULL was WORSE than BASE in all 60 chart-length
// windows (-2 % to -4.5 % log-loss skill). Kept only for transparency. Use ActivityPersistence.pine.
// =====================================================================================
// Aftershock Hazard (AHz) — RESEARCH PROTOTYPE, NOT A VALIDATED TRADING EDGE
// -------------------------------------------------------------------------------------
// Question answered:  "What is the probability that at least one SHOCK BAR occurs within
//                      the next H bars?"  A shock bar is a bar whose log high/low range
//                      exceeds the time-of-day-adjusted local level by a factor >= F.
//
// Two online-learned logistic models run side by side on the chart's own history:
//   BASE : time-of-day-normalised range memory (HAR 1/6/48/288 bars), volume surprise and
//          tail-shape statistics (vol-of-vol, 48-bar max, shock count)  -> known information
//   FULL : BASE + the research component (shock-memory kernel and pre-shock build-up,
//          i.e. the endogenous/exogenous fingerprint of the most recent shock)
// The difference FULL - BASE is the *only* part attributable to the research idea. The
// table reports a running out-of-sample log-loss skill of FULL vs BASE on THIS chart, so
// the user can see whether the component adds anything on the market being traded.
//
// Causality:  every state update happens on confirmed bars only; the label of bar t-H is
// used for learning only at the close of bar t (when it has matured). Values on an
// unconfirmed realtime bar are PROVISIONAL and drawn with a dotted line / hollow colour.
// No request.security, no lower timeframe, no future bars. Data: OHLCV of the chart only.
// Full documentation: docs/SPECIFICATION.md, docs/RESEARCH_REPORT.md
// =====================================================================================
indicator("Aftershock Hazard [research prototype]", shorttitle = "AHz", overlay = false, precision = 3, max_bars_back = 600)

// ---------------- inputs (deliberately few) ----------------
H        = input.int(12, "Horizon H (bars)", minval = 2, maxval = 48, tooltip = "Probability refers to bars t+1..t+H")
shockF   = input.float(4.0, "Shock factor F", minval = 2.0, maxval = 10.0, step = 0.5, tooltip = "Shock: bar range > F x local (time-of-day adjusted) level")
showBase = input.bool(true, "Show BASE model probability")
showTbl  = input.bool(true, "Show diagnostics table")
hiLift   = input.float(2.0, "Alert: hazard lift threshold", minval = 1.1, step = 0.1, tooltip = "Alert when FULL probability > threshold x running base rate")

// ---------------- fixed a-priori constants (see SPECIFICATION.md §3) ----------------
const float ALPHA_DAY  = 1.0 / 20.0   // time-of-day profile EWMA weight per day
const int   SHOCK_BASE = 48           // local level window for shock definition
const int   PRE_S      = 12           // pre-shock build-up window
const int   PRE_L      = 288          // pre-shock reference window
const int   EPISODE    = 48           // bars after a shock during which its memory is live
const float DECAY_P    = 0.5          // a-priori relaxation exponent of the memory kernel
const float LAM        = 0.9995       // forgetting factor of the online model
const float STD_A      = 1.0 / 2000.0 // EWMA weight for online feature standardisation
const int   WARM       = 500          // matured labels required before probabilities are shown
const int   NB_BASE    = 10           // number of BASE features
const int   NB_FULL    = 14           // number of FULL features (BASE + 4 research features)
const int   HMAX       = 49           // ring-buffer length (>= H + 1)

theta = math.log(shockF)

// ---------------- timeframe & time-of-day bucket ----------------
tfSec  = timeframe.in_seconds()
tfMin  = math.max(1, int(math.round(tfSec / 60.0)))
nB     = int(math.ceil(1440.0 / tfMin))
bucket = int(math.floor((hour(time, "UTC") * 60 + minute(time, "UTC")) / tfMin)) % nB
bpd    = 1440.0 / tfMin
gap    = na(time[1]) or (time - time[1]) > 1.5 * tfSec * 1000

// ---------------- persistent state (updated on confirmed bars only) ----------------
var array<float> profR = array.new<float>(nB, na)   // per-bucket EWMA of log range
var array<float> profV = array.new<float>(nB, na)   // per-bucket EWMA of log volume
var float lvlR = na
var float lvlV = na

rng   = math.log(high / low)
epsR  = na(lvlR) ? na : 0.1 * lvlR
lr    = math.log(rng + epsR)
dR    = profR.get(bucket)
x     = lr - dR                                       // diurnally normalised log range
sig   = math.exp(dR)                                  // expected bar range (log units)
ret   = gap ? math.log(close / open) : math.log(close / close[1])
z     = ret / sig                                     // range-normalised return
vol   = nz(volume)
epsV  = na(lvlV) ? na : 0.01 * lvlV
lv    = math.log(vol + epsV + 1e-12)
dV    = profV.get(bucket)
u     = na(dV) ? 0.0 : lv - dV                         // volume surprise (0 if no volume data)

if barstate.isconfirmed
    profR.set(bucket, na(dR) ? lr : dR + ALPHA_DAY * (lr - dR))
    profV.set(bucket, na(dV) ? lv : dV + ALPHA_DAY * (lv - dV))
    lvlR := na(lvlR) ? rng : lvlR + (rng - lvlR) / (bpd * 5)
    lvlV := na(lvlV) ? vol : lvlV + (vol - lvlV) / (bpd * 5)

// ---------------- BASE features: known information ----------------
m6    = ta.sma(x, 6)
m48   = ta.sma(x, 48)
m288  = ta.sma(x, 288)
zabs6 = ta.sma(math.abs(z), 6)
u6    = ta.sma(u, 6)
u48   = ta.sma(u, 48)
vov   = ta.stdev(x, 120, false)                       // vol-of-vol (sample stdev)
xmax  = ta.highest(x, 48)
base  = ta.sma(x[1], SHOCK_BASE)
s     = x - base                                      // surprise vs local level
shock = s > theta
nsh   = math.sum(shock ? 1.0 : 0.0, 288)

// ---------------- research component: shock memory + endogenous build-up ----------------
preS  = ta.sma(x[1], PRE_S)
preL  = ta.sma(x[1 + PRE_S], PRE_L - PRE_S)
build = preS - preL                                   // B: activity build-up before the bar
var int   lastShock = na
var float mShock    = na
var float bShock    = na
// provisional view for the current bar (a shock on THIS bar is shown before confirmation)
curIsShock = shock and not na(build)
ageNow = curIsShock ? 0 : (na(lastShock) ? na : bar_index - lastShock)
mNow   = curIsShock ? s : mShock
bNow   = curIsShock ? build : bShock
live   = not na(ageNow) and ageNow <= EPISODE
w      = live ? math.pow(1.0 + ageNow, -DECAY_P) : 0.0
fLive  = live ? 1.0 : 0.0
fM     = live ? mNow * w : 0.0
fB     = live ? bNow * w : 0.0
fBM    = live ? bNow * mNow * w : 0.0
if barstate.isconfirmed and curIsShock
    lastShock := bar_index
    mShock    := s
    bShock    := build

// ---------------- label of bar t-H (matures at the close of bar t) ----------------
yMat = ta.highest(x, H) > theta ? 1.0 : 0.0
yOk  = not na(ta.highest(x, H))

// ---------------- online standardisation + logistic model ----------------
var array<float> mu   = array.new<float>(NB_FULL, na)
var array<float> va   = array.new<float>(NB_FULL, 1.0)
var array<float> thB  = array.new<float>(NB_BASE + 1, 0.0)
var array<float> thF  = array.new<float>(NB_FULL + 1, 0.0)
var matrix<float> PB  = matrix.new<float>(NB_BASE + 1, NB_BASE + 1, 0.0)
var matrix<float> PF  = matrix.new<float>(NB_FULL + 1, NB_FULL + 1, 0.0)
var matrix<float> zBuf = matrix.new<float>(HMAX, NB_FULL + 1, na)   // standardised rows
var array<float> pBufB = array.new<float>(HMAX, na)                // stored predictions
var array<float> pBufF = array.new<float>(HMAX, na)
var int   nLearn = 0
var float llB = na
var float llF = na
var float brB = na
var float brF = na
var float baseRate = na
if barstate.isfirst
    for i = 0 to NB_BASE
        PB.set(i, i, 1.0)
    for i = 0 to NB_FULL
        PF.set(i, i, 1.0)

raw = array.from(x, m6, m48, m288, zabs6, u6, u48, vov, xmax, nsh, fLive, fM, fB, fBM)

sigmoid(float e) => 1.0 / (1.0 + math.exp(-math.max(-30.0, math.min(30.0, e))))

// one recursive Newton (EKF) step of a logistic regression on standardised row zr[0..k]
ekfStep(matrix<float> P, array<float> th, array<float> zr, int k, float y) =>
    float eta = 0.0
    for i = 0 to k
        eta += th.get(i) * zr.get(i)
    p = sigmoid(eta)
    v = math.max(p * (1 - p), 1e-4)
    Pz = array.new<float>(k + 1, 0.0)
    for i = 0 to k
        float acc = 0.0
        for j = 0 to k
            P.set(i, j, P.get(i, j) / LAM)
            acc += P.get(i, j) * zr.get(j)
        Pz.set(i, acc)
    float zPz = 0.0
    for i = 0 to k
        zPz += zr.get(i) * Pz.get(i)
    c = v / (1 + v * zPz)
    for i = 0 to k
        for j = 0 to k
            P.set(i, j, P.get(i, j) - c * Pz.get(i) * Pz.get(j))
    for i = 0 to k
        float acc = 0.0
        for j = 0 to k
            acc += P.get(i, j) * zr.get(j)
        th.set(i, th.get(i) + acc * (y - p))
    p

dot(array<float> th, array<float> zr, int k) =>
    float e = 0.0
    for i = 0 to k
        e += th.get(i) * zr.get(i)
    e

// standardise current row with statistics BEFORE including this bar
okRow = true
for i = 0 to NB_FULL - 1
    okRow := okRow and not na(raw.get(i))
zr = array.new<float>(NB_FULL + 1, 1.0)
if okRow
    for i = 0 to NB_FULL - 1
        m0 = mu.get(i)
        zz = na(m0) ? 0.0 : (raw.get(i) - m0) / math.sqrt(va.get(i) + 1e-12)
        zr.set(i + 1, math.max(-6.0, math.min(6.0, zz)))
zrB = zr.slice(0, NB_BASE + 1)

slotNow = bar_index % HMAX
slotOld = (bar_index - H) % HMAX
if barstate.isconfirmed
    // (1) update standardisation statistics with this bar
    if okRow
        for i = 0 to NB_FULL - 1
            m0 = mu.get(i)
            xi = raw.get(i)
            if na(m0)
                mu.set(i, xi)
            else
                d = xi - m0
                mu.set(i, m0 + STD_A * d)
                va.set(i, (1 - STD_A) * (va.get(i) + STD_A * d * d))
    // (2) learn from matured label of bar t-H
    if bar_index >= H and yOk and not na(zBuf.get(slotOld, 0))
        zo = zBuf.row(slotOld)
        zoB = zo.slice(0, NB_BASE + 1)
        pB0 = pBufB.get(slotOld)
        pF0 = pBufF.get(slotOld)
        if not na(pF0)     // running OOS scores of predictions made BEFORE the label existed
            a = 1.0 / 2000.0
            lB = -(yMat * math.log(math.max(pB0, 1e-6)) + (1 - yMat) * math.log(math.max(1 - pB0, 1e-6)))
            lF = -(yMat * math.log(math.max(pF0, 1e-6)) + (1 - yMat) * math.log(math.max(1 - pF0, 1e-6)))
            llB := na(llB) ? lB : llB + a * (lB - llB)
            llF := na(llF) ? lF : llF + a * (lF - llF)
            brB := na(brB) ? math.pow(pB0 - yMat, 2) : brB + a * (math.pow(pB0 - yMat, 2) - brB)
            brF := na(brF) ? math.pow(pF0 - yMat, 2) : brF + a * (math.pow(pF0 - yMat, 2) - brF)
        if nLearn == 0
            pr = 0.1
            thB.set(0, math.log(pr / (1 - pr)))
            thF.set(0, math.log(pr / (1 - pr)))
        ekfStep(PB, thB, zoB, NB_BASE, yMat)
        ekfStep(PF, thF, zo, NB_FULL, yMat)
        nLearn += 1
        baseRate := na(baseRate) ? yMat : baseRate + (yMat - baseRate) / math.min(nLearn, 5000)

// (3) predict with parameters available now
ready = okRow and nLearn >= WARM
pBase = ready ? sigmoid(dot(thB, zrB, NB_BASE)) : na
pFull = ready ? sigmoid(dot(thF, zr, NB_FULL)) : na
if barstate.isconfirmed
    for j = 0 to NB_FULL
        zBuf.set(slotNow, j, okRow ? zr.get(j) : na)
    pBufB.set(slotNow, pBase)
    pBufF.set(slotNow, pFull)

// ---------------- display ----------------
prov    = not barstate.isconfirmed
lift    = na(baseRate) or baseRate <= 0 ? na : pFull / baseRate
skillLL = na(llB) or llB <= 0 ? na : 1 - llF / llB
colFull = prov ? color.new(color.orange, 60) : lift >= hiLift ? color.red : lift >= 1.3 ? color.orange : color.teal
plot(prov ? na : pFull, "P(shock within H) — FULL (confirmed)", colFull, 2)
plot(prov ? pFull : na, "P(shock within H) — FULL (provisional, unconfirmed bar)", colFull, 3, plot.style_circles)
plot(showBase ? pBase : na, "P(shock within H) — BASE", color.new(color.gray, 30), 1)
plot(baseRate, "Running base rate", color.new(color.gray, 60), 1, plot.style_stepline)
plotshape(barstate.isconfirmed and curIsShock, "Shock bar", shape.circle, location.bottom, color.new(color.purple, 0), size = size.tiny)
bgcolor(live and not na(bNow) ? (bNow > 0 ? color.new(color.red, 92) : color.new(color.blue, 92)) : na, title = "Live shock episode (red: built-up/endogenous-like, blue: abrupt/exogenous-like)")

var table tb = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 85), border_width = 1)
fmt(float v, string d) => na(v) ? "n/a" : str.tostring(v, d)
if showTbl and barstate.islast
    tb.cell(0, 0, "AHz (prototype)", text_color = color.white), tb.cell(1, 0, prov ? "provisional" : "confirmed", text_color = color.white)
    tb.cell(0, 1, "P full / base", text_color = color.white), tb.cell(1, 1, fmt(pFull, "0.000") + " / " + fmt(pBase, "0.000"), text_color = color.white)
    tb.cell(0, 2, "base rate", text_color = color.white), tb.cell(1, 2, fmt(baseRate, "0.000"), text_color = color.white)
    tb.cell(0, 3, "lift vs base rate", text_color = color.white), tb.cell(1, 3, fmt(lift, "0.00") + "x", text_color = color.white)
    tb.cell(0, 4, "episode age / B", text_color = color.white), tb.cell(1, 4, live ? str.tostring(ageNow) + " / " + fmt(bNow, "0.00") : "none", text_color = color.white)
    tb.cell(0, 5, "OOS log-loss skill FULL vs BASE", text_color = color.white), tb.cell(1, 5, fmt(skillLL * 100, "0.00") + " %", text_color = na(skillLL) ? color.white : skillLL > 0 ? color.lime : color.red)
    tb.cell(0, 6, "OOS Brier FULL / BASE", text_color = color.white), tb.cell(1, 6, fmt(brF, "0.0000") + " / " + fmt(brB, "0.0000"), text_color = color.white)
    tb.cell(0, 7, "matured labels learned", text_color = color.white), tb.cell(1, 7, str.tostring(nLearn) + (nLearn < WARM ? " (warming up)" : ""), text_color = color.white)
    tb.cell(0, 8, "status", text_color = color.white), tb.cell(1, 8, "EXPERIMENTAL – no validated edge", text_color = color.yellow)

// ---------------- alerts (confirmed bars only) ----------------
alertcondition(barstate.isconfirmed and curIsShock, "AHz: shock bar", "Shock bar confirmed on {{ticker}} {{interval}}")
alertcondition(barstate.isconfirmed and ready and lift >= hiLift and nz(lift[1]) < hiLift, "AHz: hazard elevated", "Aftershock hazard above threshold on {{ticker}} {{interval}}")
alertcondition(barstate.isconfirmed and ready and lift < 1.2 and nz(lift[1]) >= 1.2, "AHz: hazard normalised", "Aftershock hazard back near base rate on {{ticker}} {{interval}}")
